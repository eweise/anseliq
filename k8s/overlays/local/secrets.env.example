# Copy to secrets.env (gitignored) and fill in. Becomes the anseliq-secrets Secret.

# The in-cluster Postgres (postgres.yaml) is created with this user and password on its first start.
DB_USER=anseliq
DB_PASSWORD=
# At least 32 bytes: openssl rand -base64 48
JWT_SECRET=
# The first Admin, created on first start when there's none; ignored after that. At least 8
# characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# LocalStack accepts any key. Leave both out to use the pod's IAM role instead (see
# base/service-account.yaml).
S3_USERNAME=test
S3_PASSWORD=test
